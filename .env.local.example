NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Reminders / PWA (migration 0035) ---
# Web Push VAPID keys: `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Brevo transactional API key (same account as the auth SMTP) for email reminders
BREVO_API_KEY=
BREVO_FROM_EMAIL=
# Vercel Cron auth (set any random string; Vercel sends it as a Bearer token)
CRON_SECRET=
# Service role — cron + /admin read across users
SUPABASE_SERVICE_ROLE_KEY=
